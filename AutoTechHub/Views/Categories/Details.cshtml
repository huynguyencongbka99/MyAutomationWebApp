@model AutoTechHub.Models.ViewModels.ArticleListViewModel
@{
    ViewData["Title"] = Model.CurrentCategory.Name + " - Chuyên Mục Tự Động Hóa";
}

<div class="container my-5">
    <!-- Category Hero Header -->
    <div class="card bg-body border rounded-4 p-4 p-md-5 mb-5 shadow-sm">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Categories" asp-action="Index">Chuyên mục</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.CurrentCategory.Name</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-3">
            <div class="cat-icon-circle bg-@Model.CurrentCategory.BadgeColor-subtle text-@Model.CurrentCategory.BadgeColor mb-0" style="width: 64px; height: 64px; min-width: 64px; font-size: 1.8rem;">
                <i class="bi @Model.CurrentCategory.Icon"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1">@Model.CurrentCategory.Name</h2>
                <p class="text-muted mb-0">@Model.CurrentCategory.Description</p>
            </div>
        </div>
    </div>

    <!-- Articles in Category -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <i class="bi bi-journal-text text-primary me-2"></i>Các bài viết trong chuyên mục (@Model.TotalItems)
        </h4>
        <a asp-controller="Articles" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-pencil-square me-1"></i> Đăng bài mới
        </a>
    </div>

    @if (!Model.Articles.Any())
    {
        <div class="text-center py-5 bg-body rounded-4 border shadow-sm">
            <i class="bi bi-folder-x text-muted display-4 mb-2 d-block"></i>
            <h5 class="fw-bold">Chưa có bài viết nào trong chuyên mục này</h5>
            <p class="text-muted small">Hãy là người đầu tiên chia sẻ bài viết về chủ đề này!</p>
            <a asp-controller="Articles" asp-action="Create" class="btn btn-primary btn-sm rounded-pill mt-2">
                Viết bài đầu tiên
            </a>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            @foreach (var article in Model.Articles)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="tech-card">
                        <div class="card-thumb-wrap">
                            <img src="@article.ThumbnailUrl" alt="@article.Title" class="card-thumb-img" onerror="this.src='https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=800&q=80'" />
                            <span class="card-category-badge bg-@article.Category.BadgeColor text-white">
                                @article.Category.Name
                            </span>
                        </div>
                        <div class="card-body p-3.5 d-flex flex-column">
                            <div class="d-flex align-items-center gap-2 text-muted small mb-2">
                                <span><i class="bi bi-calendar3 me-1"></i>@article.CreatedAt.ToString("dd/MM/yyyy")</span>
                                <span>•</span>
                                <span><i class="bi bi-clock me-1"></i>@article.ReadingTimeMinutes p</span>
                                <span class="ms-auto"><i class="bi bi-eye me-1"></i>@article.ViewCount</span>
                            </div>

                            <h5 class="card-title fw-bold mb-2 fs-6">
                                <a asp-controller="Articles" asp-action="Details" asp-route-slug="@article.Slug" class="text-decoration-none text-reset hover-primary">
                                    @article.Title
                                </a>
                            </h5>

                            <p class="card-text text-muted small mb-3 flex-grow-1 text-truncate-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @article.Summary
                            </p>

                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var at in article.ArticleTags.Take(3))
                                {
                                    <span class="badge bg-secondary-subtle text-secondary small">#@at.Tag.Name</span>
                                }
                            </div>

                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                <span class="small text-muted fw-semibold text-truncate" style="max-width: 140px;">
                                    <i class="bi bi-person me-1"></i>@article.AuthorName
                                </span>
                                <a asp-controller="Articles" asp-action="Details" asp-route-slug="@article.Slug" class="btn btn-xs btn-primary rounded-pill px-2.5 py-1">
                                    Đọc bài
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
