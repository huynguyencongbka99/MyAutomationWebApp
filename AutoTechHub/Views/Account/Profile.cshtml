@model AutoTechHub.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Hồ Sơ Tài Khoản";
}

<div class="container my-5" style="max-width: 680px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-person-gear text-primary me-2"></i>Hồ Sơ Cá Nhân</h2>
            <p class="text-muted small mb-0">Cập nhật tên hiển thị, giới thiệu và mật khẩu đăng nhập.</p>
        </div>
        <a asp-controller="Articles" asp-action="MyArticles" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="bi bi-file-earmark-text me-1"></i> Bài viết của tôi
        </a>
    </div>

    <div class="card bg-body border rounded-4 p-4 shadow-sm">
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4 pb-3 border-bottom">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-3" style="width: 58px; height: 58px;">
                @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
            </div>
            <div>
                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                <div class="small text-muted mb-1">@@@Model.Username • @Model.Email</div>
                <span class="badge @(Model.Role == UserRole.Admin ? "bg-danger" : Model.Role == UserRole.Manager ? "bg-success" : "bg-secondary") rounded-pill">
                    @Model.Role.GetRoleDisplayName()
                </span>
            </div>
        </div>

        <form asp-action="Profile" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small" role="alert"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold small"></label>
                <input asp-for="FullName" class="form-control" required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Bio" class="form-label fw-semibold small"></label>
                <textarea asp-for="Bio" rows="3" class="form-control" placeholder="Chia sẻ đôi nét về chuyên môn tự động hóa của bạn..."></textarea>
                <span asp-validation-for="Bio" class="text-danger small"></span>
            </div>

            <hr class="my-4" />
            <h6 class="fw-bold mb-3"><i class="bi bi-key me-1 text-primary"></i>Đổi Mật Khẩu (Bỏ trống nếu không đổi)</h6>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="CurrentPassword" class="form-label fw-semibold small"></label>
                    <input asp-for="CurrentPassword" class="form-control" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NewPassword" class="form-label fw-semibold small"></label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-save me-1"></i> Lưu thông tin
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
