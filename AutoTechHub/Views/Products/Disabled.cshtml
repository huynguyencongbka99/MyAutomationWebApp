@model AutoTechHub.Models.SiteSetting
@{
    ViewData["Title"] = "Cửa Hàng Đang Chuẩn Bị Ra Mắt";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card bg-body border rounded-4 p-5 text-center shadow-sm">
        <i class="bi bi-shop-window text-primary display-2 mb-3"></i>
        <h3 class="fw-bold mb-2">Phân Mục Bán Hàng Đang Được Chuẩn Bị</h3>
        <p class="text-muted mb-4">
            Khu vực giới thiệu thiết bị và sản phẩm tự động hóa hiện đang ở chế độ chờ. Quản trị viên sẽ mở công khai khi sẵn sàng phục vụ.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-house-door me-1"></i> Về trang chủ
            </a>
        </div>
    </div>
</div>
