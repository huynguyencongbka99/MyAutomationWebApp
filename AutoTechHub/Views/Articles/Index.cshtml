@model AutoTechHub.Models.ViewModels.ArticleListViewModel
@{
    ViewData["Title"] = "Tất Cả Bài Viết Tự Động Hóa";
}

<div class="container my-5">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Bài viết</li>
                    @if (Model.CurrentCategory != null)
                    {
                        <li class="breadcrumb-item active" aria-current="page">@Model.CurrentCategory.Name</li>
                    }
                    @if (Model.CurrentTag != null)
                    {
                        <li class="breadcrumb-item active" aria-current="page">Tag: #@Model.CurrentTag.Name</li>
                    }
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">
                @if (Model.CurrentCategory != null)
                {
                    <span><i class="bi @Model.CurrentCategory.Icon text-primary me-2"></i>@Model.CurrentCategory.Name</span>
                }
                else if (Model.CurrentTag != null)
                {
                    <span><i class="bi bi-tag-fill text-primary me-2"></i>Thẻ: #@Model.CurrentTag.Name</span>
                }
                else if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <span><i class="bi bi-search text-primary me-2"></i>Kết quả tìm kiếm: "@Model.SearchQuery"</span>
                }
                else
                {
                    <span><i class="bi bi-journal-code text-primary me-2"></i>Kho Bài Viết Tự Động Hóa</span>
                }
            </h2>
        </div>

        <a asp-controller="Articles" asp-action="Create" class="btn btn-primary rounded-pill px-3 mt-3 mt-md-0 shadow-sm">
            <i class="bi bi-pencil-square me-1"></i> Viết bài mới
        </a>
    </div>

    <!-- Filters & Search Bar -->
    <div class="card bg-body border rounded-4 p-3 mb-4 shadow-sm">
        <form asp-controller="Articles" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@Model.SearchQuery" class="form-control border-start-0" placeholder="Tìm kiếm theo từ khóa..." />
                </div>
            </div>

            <div class="col-md-3">
                <select name="category" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Tất cả chuyên mục --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Slug" selected="@(Model.CategorySlug == cat.Slug)">@cat.Name (@cat.Articles.Count(a => a.IsPublished && a.ApprovalStatus == ArticleApprovalStatus.Approved))</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="sort" class="form-select" onchange="this.form.submit()">
                    <option value="newest" selected="@(Model.SortBy == "newest")">Mới nhất</option>
                    <option value="views" selected="@(Model.SortBy == "views")">Xem nhiều nhất</option>
                    <option value="likes" selected="@(Model.SortBy == "likes")">Thích nhiều nhất</option>
                    <option value="oldest" selected="@(Model.SortBy == "oldest")">Cũ nhất</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3">
                    Lọc
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.CategorySlug) || !string.IsNullOrEmpty(Model.TagSlug))
                {
                    <a asp-controller="Articles" asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Main List & Tags Sidebar -->
    <div class="row g-4">
        <!-- Articles Grid -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small">Tìm thấy <strong>@Model.TotalItems</strong> bài viết</span>
            </div>

            @if (!Model.Articles.Any())
            {
                <div class="text-center py-5 bg-body rounded-4 border shadow-sm">
                    <i class="bi bi-journal-x text-muted display-3 mb-3 d-block"></i>
                    <h5 class="fw-bold">Không tìm thấy bài viết nào phù hợp</h5>
                    <p class="text-muted small">Hãy thử tìm kiếm bằng từ khóa khác hoặc xóa bớt bộ lọc.</p>
                    <a asp-controller="Articles" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill mt-2">
                        Xóa tất cả bộ lọc
                    </a>
                </div>
            }
            else
            {
                <div class="row g-4 mb-4">
                    @foreach (var article in Model.Articles)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="tech-card">
                                <div class="card-thumb-wrap">
                                    <img src="@article.ThumbnailUrl" alt="@article.Title" class="card-thumb-img" onerror="this.src='https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=800&q=80'" />
                                    <span class="card-category-badge bg-@article.Category.BadgeColor text-white">
                                        @article.Category.Name
                                    </span>
                                </div>
                                <div class="card-body p-3.5 d-flex flex-column">
                                    <div class="d-flex align-items-center gap-2 text-muted small mb-2">
                                        <span><i class="bi bi-calendar3 me-1"></i>@article.CreatedAt.ToString("dd/MM/yyyy")</span>
                                        <span>•</span>
                                        <span><i class="bi bi-clock me-1"></i>@article.ReadingTimeMinutes p</span>
                                        <span class="ms-auto"><i class="bi bi-eye me-1"></i>@article.ViewCount</span>
                                    </div>

                                    <h5 class="card-title fw-bold mb-2 fs-6">
                                        <a asp-controller="Articles" asp-action="Details" asp-route-slug="@article.Slug" class="text-decoration-none text-reset hover-primary">
                                            @article.Title
                                        </a>
                                    </h5>

                                    <p class="card-text text-muted small mb-3 flex-grow-1 text-truncate-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                                        @article.Summary
                                    </p>

                                    <div class="d-flex flex-wrap gap-1 mb-3">
                                        @foreach (var at in article.ArticleTags.Take(3))
                                        {
                                            <a asp-controller="Articles" asp-action="Index" asp-route-tag="@at.Tag.Slug" class="badge bg-secondary-subtle text-secondary text-decoration-none small">
                                                #@at.Tag.Name
                                            </a>
                                        }
                                    </div>

                                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                        <span class="small text-muted fw-semibold text-truncate" style="max-width: 140px;">
                                            <i class="bi bi-person me-1"></i>@article.AuthorName
                                        </span>
                                        <a asp-controller="Articles" asp-action="Details" asp-route-slug="@article.Slug" class="btn btn-xs btn-primary rounded-pill px-2.5 py-1">
                                            Đọc bài
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="d-flex justify-content-center mt-4">
                        <ul class="pagination">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-q="@Model.SearchQuery" asp-route-category="@Model.CategorySlug" asp-route-tag="@Model.TagSlug" asp-route-sort="@Model.SortBy">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-q="@Model.SearchQuery" asp-route-category="@Model.CategorySlug" asp-route-tag="@Model.TagSlug" asp-route-sort="@Model.SortBy">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-q="@Model.SearchQuery" asp-route-category="@Model.CategorySlug" asp-route-tag="@Model.TagSlug" asp-route-sort="@Model.SortBy">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>

        <!-- Sidebar (Categories, Ads & Tags) -->
        <div class="col-lg-3">
            <!-- Sidebar Ads -->
            @await Component.InvokeAsync("AdSlot", new { placement = AdPlacement.Sidebar })

            <!-- Categories List -->
            <div class="card bg-body border rounded-4 p-3.5 mb-4 shadow-sm">
                <h6 class="fw-bold mb-3 text-primary text-uppercase fs-7">
                    <i class="bi bi-folder2-open me-2"></i>Chuyên mục
                </h6>
                <div class="list-group list-group-flush">
                    <a asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-2 py-2 border-0 rounded-2 @(string.IsNullOrEmpty(Model.CategorySlug) ? "fw-bold text-primary bg-surface-alt" : "")">
                        <span>Tất cả bài viết</span>
                    </a>
                    @foreach (var cat in Model.Categories)
                    {
                        <a asp-action="Index" asp-route-category="@cat.Slug" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-2 py-2 border-0 rounded-2 @(Model.CategorySlug == cat.Slug ? "fw-bold text-primary bg-surface-alt" : "")">
                            <span><i class="bi @cat.Icon me-1.5 text-@cat.BadgeColor"></i>@cat.Name</span>
                            <span class="badge bg-secondary rounded-pill">@cat.Articles.Count(a => a.IsPublished && a.ApprovalStatus == ArticleApprovalStatus.Approved)</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Tags Cloud -->
            <div class="card bg-body border rounded-4 p-3.5 shadow-sm">
                <h6 class="fw-bold mb-3 text-primary text-uppercase fs-7">
                    <i class="bi bi-tags me-2"></i>Thẻ từ khóa
                </h6>
                <div class="d-flex flex-wrap gap-1.5">
                    @foreach (var tag in Model.Tags)
                    {
                        <a asp-action="Index" asp-route-tag="@tag.Slug" class="tag-badge @(Model.TagSlug == tag.Slug ? "bg-primary text-white" : "")">
                            #@tag.Name
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
