@model AutoTechHub.Models.ViewModels.ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    var product = Model.Product;
    var settings = Model.SiteSetting;
}

<div class="container my-4 my-md-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-3 small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Sản phẩm</a></li>
            <li class="breadcrumb-item active text-truncate" style="max-width: 240px;" aria-current="page">@product.Name</li>
        </ol>
    </nav>

    <div class="card bg-body border rounded-4 p-3 p-md-4 shadow-sm mb-5">
        <div class="row g-4 align-items-start">
            <!-- Image -->
            <div class="col-lg-5">
                <div class="rounded-4 overflow-hidden border bg-surface-alt">
                    <img src="@product.ImageUrl" alt="@product.Name" class="w-100 object-fit-cover" style="max-height: 380px;" onerror="this.src='https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=900&q=80'" />
                </div>
            </div>

            <!-- Info & Quick Order -->
            <div class="col-lg-7">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">@product.CategoryName</span>
                    @if (!string.IsNullOrWhiteSpace(product.Sku))
                    {
                        <span class="badge bg-secondary-subtle text-secondary font-monospace">SKU: @product.Sku</span>
                    }
                    @if (product.StockStatus == ProductStockStatus.InStock)
                    {
                        <span class="badge bg-success rounded-pill"><i class="bi bi-check-circle me-1"></i>Còn hàng</span>
                    }
                    else if (product.StockStatus == ProductStockStatus.PreOrder)
                    {
                        <span class="badge bg-warning text-dark rounded-pill">Đặt trước</span>
                    }
                    else if (product.StockStatus == ProductStockStatus.OutOfStock)
                    {
                        <span class="badge bg-secondary rounded-pill">Tạm hết hàng</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-dark rounded-pill">Liên hệ báo giá</span>
                    }
                </div>

                <h2 class="fw-bold mb-2">@product.Name</h2>
                <p class="text-muted mb-3">@product.ShortDescription</p>

                <div class="p-3 bg-surface-alt rounded-4 border mb-4">
                    @if (product.Price > 0 && product.StockStatus != ProductStockStatus.ContactForPrice)
                    {
                        <div class="d-flex flex-wrap align-items-baseline gap-3">
                            <span class="fs-2 fw-bold text-danger">@product.Price.ToString("N0") @product.Currency</span>
                            @if (product.OriginalPrice.HasValue && product.OriginalPrice > product.Price)
                            {
                                <span class="text-muted text-decoration-line-through fs-5">@product.OriginalPrice.Value.ToString("N0") @product.Currency</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="fs-4 fw-bold text-primary">Giá: Liên hệ nhận báo giá tốt nhất</div>
                    }
                </div>

                <!-- Direct Contact Buttons -->
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <a href="#order-inquiry-form" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm">
                        <i class="bi bi-cart-check me-1"></i> Đặt mua / Yêu cầu tư vấn
                    </a>
                    @if (!string.IsNullOrWhiteSpace(product.ExternalBuyUrl))
                    {
                        <a href="@product.ExternalBuyUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Mua qua sàn / Link ngoài
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(settings?.ContactPhone))
                    {
                        <a href="tel:@settings.ContactPhone.Replace(" ", "")" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold">
                            <i class="bi bi-telephone-fill me-1"></i> @settings.ContactPhone
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(settings?.ContactZalo))
                    {
                        <a href="@settings.ContactZalo" target="_blank" rel="noopener noreferrer" class="btn btn-outline-info rounded-pill px-3 py-2 fw-semibold">
                            <i class="bi bi-chat-dots-fill me-1"></i> Chat Zalo
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Specs & Markdown Details -->
        <div class="col-lg-7">
            <div class="card bg-body border rounded-4 p-4 shadow-sm h-100">
                <h4 class="fw-bold mb-3 pb-2 border-bottom">
                    <i class="bi bi-card-list text-primary me-2"></i>Thông Tin Chi Tiết &amp; Thông Số Kỹ Thuật
                </h4>
                <div class="article-content">
                    @if (!string.IsNullOrWhiteSpace(product.DescriptionHtml))
                    {
                        @Html.Raw(product.DescriptionHtml)
                    }
                    else
                    {
                        <p class="text-muted">@product.ShortDescription</p>
                    }
                </div>
            </div>
        </div>

        <!-- Order / Consultation Form -->
        <div class="col-lg-5" id="order-inquiry-form">
            <div class="card bg-body border rounded-4 p-4 shadow-sm">
                <h5 class="fw-bold mb-1 text-danger">
                    <i class="bi bi-bag-heart-fill me-2"></i>Gửi Yêu Cầu Đặt Hàng / Tư Vấn
                </h5>
                <p class="small text-muted mb-3">Để lại thông tin bên dưới, kỹ sư của chúng tôi sẽ liên hệ xác nhận và hỗ trợ kỹ thuật.</p>

                <form asp-action="SubmitInquiry" method="post">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="slug" value="@product.Slug" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Họ và tên *</label>
                        <input type="text" name="CustomerName" value="@(User.Identity.IsAuthenticated ? User.GetFullName() : "")" class="form-control" required placeholder="Nguyễn Văn A" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-semibold">Số điện thoại / Zalo *</label>
                            <input type="tel" name="Phone" class="form-control" required placeholder="09xx xxx xxx" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Số lượng</label>
                            <input type="number" name="Quantity" value="1" min="1" max="1000" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Email (tùy chọn)</label>
                        <input type="email" name="Email" class="form-control" placeholder="email@congty.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú yêu cầu</label>
                        <textarea name="Note" rows="3" class="form-control" placeholder="Yêu cầu hóa đơn VAT, cấu hình tùy chỉnh, địa chỉ giao hàng..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 rounded-pill py-2.5 fw-bold shadow-sm">
                        <i class="bi bi-send-fill me-1"></i> Gửi yêu cầu ngay
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (Model.RelatedProducts.Any())
    {
        <div class="mt-5">
            <h4 class="fw-bold mb-4"><i class="bi bi-grid-3x3-gap text-primary me-2"></i>Sản Phẩm Liên Quan</h4>
            <div class="row g-4">
                @foreach (var rel in Model.RelatedProducts)
                {
                    <div class="col-md-4">
                        <div class="product-card">
                            <div class="card-thumb-wrap">
                                <img src="@rel.ImageUrl" alt="@rel.Name" class="card-thumb-img" />
                            </div>
                            <div class="card-body p-3 d-flex flex-column">
                                <h6 class="fw-bold mb-2">
                                    <a asp-action="Details" asp-route-slug="@rel.Slug" class="text-decoration-none text-reset hover-primary">@rel.Name</a>
                                </h6>
                                <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                    <span class="fw-bold text-danger small">@(rel.Price > 0 ? $"{rel.Price:N0} {rel.Currency}" : "Liên hệ")</span>
                                    <a asp-action="Details" asp-route-slug="@rel.Slug" class="btn btn-sm btn-outline-danger rounded-pill">Xem</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
