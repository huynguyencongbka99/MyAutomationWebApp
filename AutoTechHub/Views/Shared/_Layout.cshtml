<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoTech Hub | Chia Sẻ Kiến Thức Tự Động Hóa</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Prism.js Syntax Highlighting CSS -->
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/line-numbers/prism-line-numbers.min.css" rel="stylesheet" />

    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div id="reading-progress"></div>

    <!-- Header / Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-cpu-fill text-primary"></i>
                    <span>Auto<span class="text-info">Tech</span>Hub</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Articles" asp-action="Index">
                                <i class="bi bi-journal-code me-1"></i> Tất cả bài viết
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> Chuyên mục
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Snippets" asp-action="Index">
                                <i class="bi bi-code-slash me-1"></i> Kho Snippets
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Quản lý
                            </a>
                        </li>
                    </ul>

                    <!-- Search Quick Form -->
                    <form class="d-flex me-3" asp-controller="Articles" asp-action="Index" method="get">
                        <div class="input-group input-group-sm">
                            <input class="form-control" type="search" name="q" placeholder="Tìm PLC, Modbus, Python..." aria-label="Search" style="min-width: 180px; border-radius: 8px 0 0 8px;">
                            <button class="btn btn-outline-primary" type="submit" style="border-radius: 0 8px 8px 0;">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <!-- Actions -->
                    <div class="d-flex align-items-center gap-2">
                        <!-- Theme switch -->
                        <button id="theme-toggle-btn" class="btn btn-outline-secondary btn-sm p-2 rounded-circle" type="button" title="Chuyển đổi giao diện Sáng / Tối" style="width: 36px; height: 36px;">
                            <i id="theme-toggle-icon" class="bi bi-moon-stars-fill text-primary"></i>
                        </button>

                        <!-- Write Article Button -->
                        <a class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm" asp-controller="Articles" asp-action="Create">
                            <i class="bi bi-pencil-square me-1"></i> Viết bài
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Alert Messages -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <a class="brand-logo mb-3 d-inline-block text-decoration-none" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-cpu-fill text-primary"></i>
                        <span>Auto<span class="text-info">Tech</span>Hub</span>
                    </a>
                    <p class="small text-muted pe-lg-4">
                        Nền tảng chia sẻ kiến thức, kinh nghiệm thực chiến và thư viện mã nguồn về Tự động hóa công nghiệp (PLC/SCADA/IoT), RPA, DevOps và AI Vision.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="https://github.com" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle" style="width: 34px; height: 34px;"><i class="bi bi-github"></i></a>
                        <a href="https://youtube.com" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle" style="width: 34px; height: 34px;"><i class="bi bi-youtube text-danger"></i></a>
                        <a href="https://linkedin.com" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle" style="width: 34px; height: 34px;"><i class="bi bi-linkedin text-info"></i></a>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-uppercase fs-7 text-primary">Chuyên mục nổi bật</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a asp-controller="Categories" asp-action="Details" asp-route-slug="industrial-automation" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Tự động hóa công nghiệp</a></li>
                        <li><a asp-controller="Categories" asp-action="Details" asp-route-slug="software-rpa" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Phần mềm & RPA</a></li>
                        <li><a asp-controller="Categories" asp-action="Details" asp-route-slug="iot-embedded" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> IoT & Hệ thống nhúng</a></li>
                        <li><a asp-controller="Categories" asp-action="Details" asp-route-slug="ai-vision" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> AI & Thị giác máy tính</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3 text-uppercase fs-7 text-primary">Liên kết nhanh</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a asp-controller="Articles" asp-action="Index" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Danh sách bài viết</a></li>
                        <li><a asp-controller="Snippets" asp-action="Index" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Kho Code Snippets</a></li>
                        <li><a asp-controller="Articles" asp-action="Create" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Đăng bài mới</a></li>
                        <li><a asp-controller="Home" asp-action="About" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Giới thiệu website</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-uppercase fs-7 text-primary">Công nghệ xây dựng</h6>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-secondary">ASP.NET Core</span>
                        <span class="badge bg-secondary">C# .NET</span>
                        <span class="badge bg-secondary">EF Core</span>
                        <span class="badge bg-secondary">SQLite</span>
                        <span class="badge bg-secondary">Markdig</span>
                        <span class="badge bg-secondary">Bootstrap 5</span>
                    </div>
                    <p class="small text-muted mt-3 mb-0">
                        &copy; @DateTime.UtcNow.Year AutoTech Hub. Nền tảng mở phục vụ cộng đồng kỹ sư tự động hóa.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Prism.js for Syntax Highlighting -->
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-csharp.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-python.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-cpp.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-bash.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-json.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-yaml.min.js"></script>

    <!-- Marked.js for Client Live Preview -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <!-- Custom App JS -->
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
