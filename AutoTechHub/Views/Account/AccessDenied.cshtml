@{
    ViewData["Title"] = "Không Có Quyền Truy Cập";
}

<div class="container my-5" style="max-width: 560px;">
    <div class="card bg-body border rounded-4 p-5 text-center shadow-sm">
        <i class="bi bi-shield-exclamation text-danger display-2 mb-3"></i>
        <h3 class="fw-bold mb-2">Bạn Không Có Quyền Truy Cập</h3>
        <p class="text-muted mb-4">
            Khu vực này chỉ dành cho tài khoản có phân quyền phù hợp (Admin hoặc Quản lý). Nếu bạn là thành viên, bạn vẫn có thể viết bài và gửi chờ Admin phê duyệt.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-house-door me-1"></i> Về trang chủ
            </a>
            <a asp-controller="Articles" asp-action="MyArticles" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-file-earmark-text me-1"></i> Bài viết của tôi
            </a>
        </div>
    </div>
</div>
