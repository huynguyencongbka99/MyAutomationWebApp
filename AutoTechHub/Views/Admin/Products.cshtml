@model AutoTechHub.Models.ViewModels.AdminProductsViewModel
@{
    ViewData["Title"] = "Quản Lý Bán Hàng & Mặt Hàng";
}

<div class="container my-4 my-md-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-shop text-danger me-2"></i>Giới Thiệu &amp; Bán Hàng (Mở Rộng)
            </h2>
            <p class="text-muted small mb-0">Chuẩn bị sẵn danh sách mặt hàng và bật/tắt chế độ bán hàng công khai khi cần.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3 btn-sm">
                <i class="bi bi-eye me-1"></i> Xem trang Sản phẩm
            </a>
            <a asp-action="CreateProduct" class="btn btn-danger rounded-pill px-4 btn-sm shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Thêm mặt hàng
            </a>
        </div>
    </div>

    <partial name="_AdminNav" />

    <!-- Shop Module Standby / Active Settings -->
    <div class="card bg-body border rounded-4 p-3 p-md-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3 text-danger"><i class="bi bi-sliders me-2"></i>Cấu Hình Trạng Thái &amp; Thông Tin Bán Hàng</h5>
        <form asp-action="UpdateShopSettings" method="post">
            <input type="hidden" name="returnAction" value="Products" />
            <div class="p-3 bg-surface-alt rounded-4 border mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <div class="fw-bold">Kích hoạt phân mục Bán hàng trên Website</div>
                    <div class="small text-muted">Khi TẮT: menu Sản phẩm và khối bán hàng trên trang chủ sẽ ẩn (chế độ chờ). Khi BẬT: hiển thị công khai cho khách hàng.</div>
                </div>
                <div class="form-check form-switch m-0">
                    <input name="EnableShopModule" value="true" class="form-check-input" type="checkbox" role="switch" id="shopEnableSwitch" checked="@Model.SiteSetting.EnableShopModule" style="width: 3em; height: 1.5em;">
                    <input type="hidden" name="EnableShopModule" value="false" />
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Tên trên thanh Menu</label>
                    <input name="ShopNavTitle" value="@Model.SiteSetting.ShopNavTitle" class="form-control" placeholder="Sản phẩm" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Hotline đặt hàng</label>
                    <input name="ContactPhone" value="@Model.SiteSetting.ContactPhone" class="form-control" placeholder="0900 123 456" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Link Zalo tư vấn</label>
                    <input name="ContactZalo" value="@Model.SiteSetting.ContactZalo" class="form-control" placeholder="https://zalo.me/..." />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Tiêu đề khu vực sản phẩm</label>
                    <input name="ShopBannerTitle" value="@Model.SiteSetting.ShopBannerTitle" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Email liên hệ bán hàng</label>
                    <input name="ContactEmail" value="@Model.SiteSetting.ContactEmail" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Mô tả ngắn khu vực sản phẩm</label>
                    <input name="ShopBannerSubtitle" value="@Model.SiteSetting.ShopBannerSubtitle" class="form-control" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                <i class="bi bi-save me-1"></i> Lưu cấu hình bán hàng
            </button>
        </form>
    </div>

    <!-- Products List -->
    <div class="card bg-body border rounded-4 p-3 p-md-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-box-seam text-primary me-2"></i>Danh Sách Mặt Hàng (@Model.Products.Count)</h5>

        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th>Tình trạng</th>
                        <th>Hiển thị</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@p.ImageUrl" alt="@p.Name" class="rounded-2 object-fit-cover" style="width: 48px; height: 48px;" />
                                    <div>
                                        <div class="fw-bold">@p.Name</div>
                                        <div class="small text-muted font-monospace">@p.Sku</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-secondary-subtle text-secondary">@p.CategoryName</span></td>
                            <td class="fw-bold text-danger">@(p.Price > 0 ? $"{p.Price:N0} {p.Currency}" : "Liên hệ")</td>
                            <td><span class="badge bg-info-subtle text-info">@p.StockStatus</span></td>
                            <td>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" role="switch" checked="@p.IsActive" onchange="toggleProduct(@p.Id, this)">
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-outline-secondary" title="Sửa"><i class="bi bi-pencil"></i></a>
                                    <a asp-controller="Products" asp-action="Details" asp-route-slug="@p.Slug" class="btn btn-outline-primary" title="Xem"><i class="bi bi-eye"></i></a>
                                    <form asp-action="DeleteProduct" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Xóa mặt hàng này?');" style="display:inline;">
                                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Product Cards -->
        <div class="d-md-none d-flex flex-column gap-3">
            @foreach (var p in Model.Products)
            {
                <div class="p-3 bg-surface-alt rounded-4 border">
                    <div class="d-flex gap-3 align-items-center mb-2">
                        <img src="@p.ImageUrl" alt="@p.Name" class="rounded-3 object-fit-cover" style="width: 56px; height: 56px;" />
                        <div class="flex-grow-1">
                            <div class="fw-bold small">@p.Name</div>
                            <div class="text-danger fw-bold small">@(p.Price > 0 ? $"{p.Price:N0} {p.Currency}" : "Liên hệ")</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" checked="@p.IsActive" onchange="toggleProduct(@p.Id, this)">
                            <label class="form-check-label small">@(p.IsActive ? "Hiện" : "Ẩn")</label>
                        </div>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Sửa</a>
                            <form asp-action="DeleteProduct" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Xóa mặt hàng này?');" style="display:inline;">
                                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Customer Inquiries -->
    <div class="card bg-body border rounded-4 p-3 p-md-4 shadow-sm">
        <h5 class="fw-bold mb-3"><i class="bi bi-cart-check text-danger me-2"></i>Yêu Cầu Đặt Hàng &amp; Tư Vấn (@Model.Inquiries.Count)</h5>

        @if (!Model.Inquiries.Any())
        {
            <div class="text-center py-4 text-muted small bg-surface-alt rounded-3">
                Chưa có yêu cầu đặt mua / tư vấn nào từ khách hàng.
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var inq in Model.Inquiries)
                {
                    <div class="p-3 bg-surface-alt rounded-4 border">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                            <div>
                                <div class="fw-bold">
                                    @inq.CustomerName — <span class="text-primary">@inq.Phone</span>
                                    <span class="badge bg-dark ms-1">SL: @inq.Quantity</span>
                                </div>
                                <div class="small text-muted">
                                    Sản phẩm: <strong>@inq.Product?.Name</strong> • @inq.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </div>
                                @if (!string.IsNullOrWhiteSpace(inq.Note))
                                {
                                    <div class="small mt-1">Ghi chú: <em>@inq.Note</em></div>
                                }
                            </div>

                            <form asp-action="UpdateInquiryStatus" method="post" class="flex-shrink-0">
                                <input type="hidden" name="id" value="@inq.Id" />
                                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="@ProductInquiryStatus.Pending" selected="@(inq.Status == ProductInquiryStatus.Pending)">Mới tiếp nhận</option>
                                    <option value="@ProductInquiryStatus.Contacted" selected="@(inq.Status == ProductInquiryStatus.Contacted)">Đã liên hệ</option>
                                    <option value="@ProductInquiryStatus.Completed" selected="@(inq.Status == ProductInquiryStatus.Completed)">Hoàn tất</option>
                                    <option value="@ProductInquiryStatus.Cancelled" selected="@(inq.Status == ProductInquiryStatus.Cancelled)">Đã hủy</option>
                                </select>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        async function toggleProduct(id, cb) {
            const res = await fetch(`/Admin/ToggleProductActive/${id}`, { method: 'POST' });
            if (!res.ok) cb.checked = !cb.checked;
        }
    </script>
}
