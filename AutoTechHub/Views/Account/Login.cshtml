@model AutoTechHub.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Hệ Thống";
}

<div class="container my-5" style="max-width: 460px;">
    <div class="card bg-body border rounded-4 p-4 p-md-5 shadow-sm">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3" style="width: 56px; height: 56px;">
                <i class="bi bi-shield-lock-fill fs-3"></i>
            </div>
            <h3 class="fw-bold mb-1">Đăng Nhập Hệ Thống</h3>
            <p class="small text-muted mb-0">Đăng nhập bằng tài khoản của bạn để viết bài, theo dõi phê duyệt hoặc quản trị website.</p>
        </div>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            @if (!string.IsNullOrWhiteSpace(Model?.ReturnUrl) && Model.ReturnUrl.Contains("Articles", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-info rounded-3 small py-2 mb-3">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Bạn cần đăng nhập tài khoản (từ vai trò <strong>User / Thành viên</strong> trở lên) để viết và gửi bài. Chưa có tài khoản? Hãy bấm <a asp-action="Register" class="fw-semibold">Đăng ký</a>.
                </div>
            }
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="UsernameOrEmail" class="form-label fw-semibold small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent"><i class="bi bi-person text-muted"></i></span>
                    <input asp-for="UsernameOrEmail" id="login-username" class="form-control" placeholder="Tên đăng nhập hoặc email..." autocomplete="username" required />
                </div>
                <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent"><i class="bi bi-key text-muted"></i></span>
                    <input asp-for="Password" id="login-password" class="form-control" placeholder="Nhập mật khẩu..." autocomplete="current-password" required />
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('login-password', this)" title="Hiện/Ẩn mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small"></label>
                </div>
                <a asp-action="Register" class="small text-decoration-none fw-semibold">Chưa có tài khoản? Đăng ký</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-pill py-2.5 fw-bold shadow-sm">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
            </button>
        </form>

        <div class="mt-4 pt-3 border-top text-center small text-muted">
            <i class="bi bi-shield-check text-success me-1"></i> Quên mật khẩu? Liên hệ quản trị viên (Admin) để được cấp lại mật khẩu mới.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd(inputId, btn) {
            const el = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (el.type === 'password') {
                el.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                el.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
}
