@model IEnumerable<AutoTechHub.Models.Category>
@{
    ViewData["Title"] = "Chuyên Mục Tự Động Hóa";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-1.5 rounded-pill fw-semibold mb-2">
            <i class="bi bi-grid-fill me-1"></i>Hệ Thống Phân Loại
        </span>
        <h2 class="fw-bold display-6">Chuyên Mục Chủ Đề Tự Động Hóa</h2>
        <p class="text-muted mx-auto" style="max-width: 600px;">
            Duyệt qua các bài viết, kiến trúc hệ thống và hướng dẫn thực tế theo từng lĩnh vực kỹ thuật chuyên biệt.
        </p>
    </div>

    <div class="row g-4">
        @foreach (var cat in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="tech-card h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="cat-icon-circle bg-@cat.BadgeColor-subtle text-@cat.BadgeColor mb-3">
                            <i class="bi @cat.Icon fs-3"></i>
                        </div>
                        <h4 class="fw-bold mb-2">
                            <a asp-action="Details" asp-route-slug="@cat.Slug" class="text-decoration-none text-reset hover-primary">
                                @cat.Name
                            </a>
                        </h4>
                        <p class="text-muted small mb-4" style="line-height: 1.6;">
                            @cat.Description
                        </p>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                        <span class="badge bg-secondary-subtle text-secondary fw-semibold">
                            @cat.Articles.Count(a => a.IsPublished && a.ApprovalStatus == ArticleApprovalStatus.Approved) bài viết
                        </span>
                        <a asp-action="Details" asp-route-slug="@cat.Slug" class="btn btn-sm btn-outline-@cat.BadgeColor rounded-pill px-3">
                            Khám phá <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
