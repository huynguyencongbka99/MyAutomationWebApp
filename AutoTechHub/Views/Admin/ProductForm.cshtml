@model AutoTechHub.Models.Product
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Chỉnh Sửa Mặt Hàng" : "Thêm Mặt Hàng Mới";
}

<div class="container my-4 my-md-5" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-box-seam text-danger me-2"></i>@ViewData["Title"]
        </h3>
        <a asp-action="Products" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card bg-body border rounded-4 p-4 shadow-sm">
        <form asp-action="@(isEdit ? "EditProduct" : "CreateProduct")" asp-route-id="@(isEdit ? Model.Id : (int?)null)" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label fw-semibold small"></label>
                    <input asp-for="Name" class="form-control" required placeholder="Bộ kit thực hành PLC Siemens S7-1200" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Sku" class="form-label fw-semibold small"></label>
                    <input asp-for="Sku" class="form-control" placeholder="ATH-PLC-001" />
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="CategoryName" class="form-label fw-semibold small"></label>
                    <input asp-for="CategoryName" class="form-control" required placeholder="Thiết bị PLC & Tự động hóa" />
                    <span asp-validation-for="CategoryName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="StockStatus" class="form-label fw-semibold small"></label>
                    <select asp-for="StockStatus" asp-items="Html.GetEnumSelectList<ProductStockStatus>()" class="form-select"></select>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Price" class="form-label fw-semibold small"></label>
                    <input asp-for="Price" type="number" step="1000" class="form-control" placeholder="0 = Liên hệ báo giá" />
                </div>
                <div class="col-md-4">
                    <label asp-for="OriginalPrice" class="form-label fw-semibold small"></label>
                    <input asp-for="OriginalPrice" type="number" step="1000" class="form-control" placeholder="Tùy chọn" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Currency" class="form-label fw-semibold small"></label>
                    <input asp-for="Currency" class="form-control" />
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="ImageUrl" class="form-label fw-semibold small"></label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
                </div>
                <div class="col-md-6">
                    <label asp-for="ExternalBuyUrl" class="form-label fw-semibold small"></label>
                    <input asp-for="ExternalBuyUrl" class="form-control" placeholder="Link Shopee / Zalo / Gumroad (nếu có)" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ShortDescription" class="form-label fw-semibold small"></label>
                <textarea asp-for="ShortDescription" rows="2" class="form-control" required></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DescriptionMarkdown" class="form-label fw-semibold small"></label>
                <textarea asp-for="DescriptionMarkdown" rows="8" class="form-control font-monospace"></textarea>
            </div>

            <div class="row g-3 mb-4 align-items-center">
                <div class="col-md-4">
                    <label asp-for="DisplayOrder" class="form-label fw-semibold small"></label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                </div>
                <div class="col-md-4 pt-md-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                        <label asp-for="IsFeatured" class="form-check-label fw-semibold small"></label>
                    </div>
                </div>
                <div class="col-md-4 pt-md-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold small"></label>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm">
                <i class="bi bi-save me-1"></i> Lưu mặt hàng
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
