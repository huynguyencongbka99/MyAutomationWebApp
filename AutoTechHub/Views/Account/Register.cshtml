@model AutoTechHub.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Thành Viên";
}

<div class="container my-5" style="max-width: 520px;">
    <div class="card bg-body border rounded-4 p-4 p-md-5 shadow-sm">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success mb-3" style="width: 56px; height: 56px;">
                <i class="bi bi-person-plus-fill fs-3"></i>
            </div>
            <h3 class="fw-bold mb-1">Tạo Tài Khoản Mới</h3>
            <p class="small text-muted mb-0">Thành viên sau khi đăng ký có thể viết bài và gửi chờ Admin phê duyệt.</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-semibold small"></label>
                <input asp-for="Username" class="form-control" placeholder="vd: kysu_tudonghoa" required />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold small"></label>
                <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold small"></label>
                <input asp-for="Email" class="form-control" placeholder="email@example.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold small"></label>
                    <input asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100 rounded-pill py-2.5 fw-bold shadow-sm">
                <i class="bi bi-check2-circle me-1"></i> Đăng ký tài khoản
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top small">
            Đã có tài khoản? <a asp-action="Login" class="fw-semibold text-decoration-none">Đăng nhập ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
