@model AutoTechHub.Models.ViewModels.ForceChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi Mật Khẩu Bắt Buộc";
}

<div class="container my-5" style="max-width: 500px;">
    <div class="card bg-body border border-warning rounded-4 p-4 p-md-5 shadow-sm">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning mb-3" style="width: 58px; height: 58px;">
                <i class="bi bi-shield-lock-fill fs-2"></i>
            </div>
            <h3 class="fw-bold mb-1">Cập Nhật Mật Khẩu Mới</h3>
            <p class="small text-muted mb-0">
                Xin chào <strong>@Model.FullName</strong> (@@@Model.Username). Vì lý do bảo mật hoặc do mật khẩu vừa được đặt lại, bạn cần thiết lập mật khẩu mới trước khi tiếp tục.
            </p>
        </div>

        <form asp-action="ForceChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-semibold small"></label>
                <input asp-for="NewPassword" class="form-control" placeholder="Ít nhất 6 ký tự..." autocomplete="new-password" required />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label fw-semibold small"></label>
                <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Nhập lại mật khẩu mới..." autocomplete="new-password" required />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-pill py-2.5 fw-bold shadow-sm mb-3">
                <i class="bi bi-check2-circle me-1"></i> Xác nhận đổi mật khẩu
            </button>
        </form>

        <form asp-action="Logout" method="post" class="text-center">
            <button type="submit" class="btn btn-link btn-sm text-muted text-decoration-none">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất tài khoản khác
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
