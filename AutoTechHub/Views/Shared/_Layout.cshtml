@inject AutoTechHub.Services.ISiteConfigService SiteConfigService
@{
    var siteSetting = await SiteConfigService.GetSettingsAsync();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool isAuthenticated = User.Identity.IsAuthenticated;
    bool isAdmin = User.IsInRole(nameof(UserRole.Admin));
    bool isManager = User.IsInRole(nameof(UserRole.Manager));
    bool isAdminOrManager = isAdmin || isManager;
    var fullName = User.GetFullName();
    var role = User.GetUserRole();
    var siteName = string.IsNullOrWhiteSpace(siteSetting?.SiteName) ? "AutoTechHub" : siteSetting.SiteName;
    var siteTagline = string.IsNullOrWhiteSpace(siteSetting?.SiteTagline) ? "Chia Sẻ Kiến Thức Tự Động Hóa" : siteSetting.SiteTagline;
    var logoUrl = string.IsNullOrWhiteSpace(siteSetting?.LogoUrl) ? "/images/logo-default.svg" : siteSetting.LogoUrl;
    var faviconUrl = string.IsNullOrWhiteSpace(siteSetting?.FaviconUrl) ? "/images/favicon.svg" : siteSetting.FaviconUrl;
    var showBrandText = siteSetting?.ShowBrandTextWithLogo ?? true;
    var primaryColor = string.IsNullOrWhiteSpace(siteSetting?.PrimaryColor) ? "#0d6efd" : siteSetting.PrimaryColor;
    var accentColor = string.IsNullOrWhiteSpace(siteSetting?.AccentColor) ? "#0dcaf0" : siteSetting.AccentColor;
    var fontFamily = string.IsNullOrWhiteSpace(siteSetting?.FontFamily) ? "Segoe UI" : siteSetting.FontFamily;
    var cardRadius = siteSetting?.CardRadiusPx ?? 16;
    var defaultTheme = string.IsNullOrWhiteSpace(siteSetting?.DefaultTheme) ? "auto" : siteSetting.DefaultTheme;
    var footerDescription = string.IsNullOrWhiteSpace(siteSetting?.FooterDescription)
        ? "Nền tảng chia sẻ kiến thức, kinh nghiệm thực chiến và thư viện mã nguồn về Tự động hóa công nghiệp (PLC/SCADA/IoT), RPA, DevOps và AI Vision."
        : siteSetting.FooterDescription;
    var githubUrl = string.IsNullOrWhiteSpace(siteSetting?.GithubUrl) ? "https://github.com" : siteSetting.GithubUrl;
    var youtubeUrl = string.IsNullOrWhiteSpace(siteSetting?.YoutubeUrl) ? "https://youtube.com" : siteSetting.YoutubeUrl;
    var linkedinUrl = string.IsNullOrWhiteSpace(siteSetting?.LinkedinUrl) ? "https://linkedin.com" : siteSetting.LinkedinUrl;
    var fontStack = fontFamily switch
    {
        "Be Vietnam Pro" => "'Be Vietnam Pro', system-ui, sans-serif",
        "Inter" => "'Inter', system-ui, sans-serif",
        "Roboto" => "'Roboto', system-ui, sans-serif",
        _ => "'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
    };
}
<!DOCTYPE html>
<html lang="vi" data-default-theme="@defaultTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteName | @siteTagline</title>
    <link rel="icon" href="@faviconUrl" />

    @if (fontFamily == "Be Vietnam Pro")
    {
        <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    }
    else if (fontFamily == "Inter")
    {
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    }
    else if (fontFamily == "Roboto")
    {
        <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet" />
    }
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Prism.js Syntax Highlighting CSS -->
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/line-numbers/prism-line-numbers.min.css" rel="stylesheet" />

    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Dynamic Theme Variables from Web Designer -->
    <style id="dynamic-theme-vars">
        :root {
            --primary-color: @primaryColor;
            --accent-cyan: @accentColor;
            --card-radius: @(cardRadius)px;
            --app-font: @Html.Raw(fontStack);
            --bs-primary: @primaryColor;
            --bs-link-color: @primaryColor;
        }
        .btn-primary {
            --bs-btn-bg: @primaryColor;
            --bs-btn-border-color: @primaryColor;
        }
        .btn-outline-primary {
            --bs-btn-color: @primaryColor;
            --bs-btn-border-color: @primaryColor;
            --bs-btn-hover-bg: @primaryColor;
            --bs-btn-hover-border-color: @primaryColor;
        }
        .brand-logo {
            background: linear-gradient(135deg, @primaryColor 0%, @accentColor 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-highlight {
            background: linear-gradient(135deg, @primaryColor 0%, @accentColor 55%, #6610f2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        #reading-progress {
            background: linear-gradient(90deg, @primaryColor, @accentColor);
        }
    </style>
    @if (!string.IsNullOrWhiteSpace(siteSetting?.CustomCss))
    {
        <style id="custom-user-css">@Html.Raw(siteSetting.CustomCss)</style>
    }
</head>
<body>
    <div id="reading-progress"></div>

    <!-- Header / Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
                    <img src="@logoUrl" alt="@siteName Logo" class="rounded-2" style="height: 34px; width: auto; max-width: 140px; object-fit: contain;" onerror="this.src='/images/logo-default.svg'" />
                    @if (showBrandText)
                    {
                        <span>@siteName</span>
                    }
                </a>

                <!-- Mobile quick buttons -->
                <div class="d-flex d-lg-none align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm p-2 rounded-circle theme-toggle-trigger" type="button" title="Chuyển giao diện Sáng / Tối" style="width: 38px; height: 38px;">
                        <i class="bi bi-moon-stars-fill text-primary theme-toggle-icon"></i>
                    </button>
                    <button class="btn btn-outline-primary btn-sm px-2.5 py-1.5 rounded-3 d-inline-flex align-items-center gap-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavDrawer" aria-controls="mobileNavDrawer">
                        <i class="bi bi-list fs-5"></i>
                        <span class="small fw-semibold">Menu</span>
                    </button>
                </div>

                <!-- Desktop Navbar -->
                <div class="collapse navbar-collapse d-none d-lg-flex" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Articles" && currentAction != "MyArticles" && currentAction != "Create" ? "active" : "")" asp-controller="Articles" asp-action="Index">
                                <i class="bi bi-journal-code me-1"></i> Bài viết
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> Chuyên mục
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Snippets" ? "active" : "")" asp-controller="Snippets" asp-action="Index">
                                <i class="bi bi-code-slash me-1"></i> Snippets
                            </a>
                        </li>
                        @if (siteSetting.EnableShopModule || isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index">
                                    <i class="bi bi-bag-check me-1"></i> @(string.IsNullOrWhiteSpace(siteSetting.ShopNavTitle) ? "Sản phẩm" : siteSetting.ShopNavTitle)
                                    @if (!siteSetting.EnableShopModule && isAdmin)
                                    {
                                        <span class="badge bg-warning text-dark ms-1" style="font-size:0.65rem;">Chờ</span>
                                    }
                                </a>
                            </li>
                        }
                        @if (isAdminOrManager)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Quản lý
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Search Quick Form -->
                    <form class="d-flex me-2" asp-controller="Articles" asp-action="Index" method="get">
                        <div class="input-group input-group-sm">
                            <input class="form-control" type="search" name="q" placeholder="Tìm PLC, Modbus..." aria-label="Search" style="width: 155px; border-radius: 8px 0 0 8px;">
                            <button class="btn btn-outline-primary" type="submit" style="border-radius: 0 8px 8px 0;">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <!-- Actions & Account -->
                    <div class="d-flex align-items-center gap-2">
                        <button id="theme-toggle-btn" class="btn btn-outline-secondary btn-sm p-2 rounded-circle theme-toggle-trigger" type="button" title="Chuyển đổi giao diện Sáng / Tối" style="width: 36px; height: 36px;">
                            <i id="theme-toggle-icon" class="bi bi-moon-stars-fill text-primary theme-toggle-icon"></i>
                        </button>

                        <a class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm" asp-controller="Articles" asp-action="Create">
                            <i class="bi bi-pencil-square me-1"></i> Viết bài
                        </a>

                        @if (isAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm rounded-pill px-2.5 py-1 dropdown-toggle d-flex align-items-center gap-1.5" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.75rem;">
                                        @(string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper())
                                    </span>
                                    <span class="small fw-semibold text-truncate" style="max-width: 110px;">@fullName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border rounded-3 p-2" style="min-width: 240px;">
                                    <li class="px-2 py-1.5 mb-1 border-bottom">
                                        <div class="fw-bold small">@fullName</div>
                                        <span class="badge @(isAdmin ? "bg-danger" : isManager ? "bg-success" : "bg-secondary") rounded-pill mt-1" style="font-size: 0.7rem;">
                                            @role.GetRoleDisplayName()
                                        </span>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-2 py-1.5 small" asp-controller="Articles" asp-action="MyArticles">
                                            <i class="bi bi-file-earmark-text me-2 text-primary"></i>Bài viết của tôi
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-2 py-1.5 small" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear me-2 text-info"></i>Hồ sơ cá nhân
                                        </a>
                                    </li>
                                    @if (isAdminOrManager)
                                    {
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item rounded-2 py-1.5 small fw-semibold" asp-controller="Admin" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2 text-warning"></i>@(isAdmin ? "Quản trị hệ thống" : "Quản lý bài viết")
                                            </a>
                                        </li>
                                    }
                                    @if (isAdmin)
                                    {
                                        <li>
                                            <a class="dropdown-item rounded-2 py-1.5 small" asp-controller="Admin" asp-action="Users">
                                                <i class="bi bi-people me-2 text-primary"></i>Phân quyền & Tài khoản
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-2 py-1.5 small" asp-controller="Admin" asp-action="Ads">
                                                <i class="bi bi-megaphone me-2 text-success"></i>Quản lý Quảng cáo
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-2 py-1.5 small" asp-controller="Admin" asp-action="Products">
                                                <i class="bi bi-shop me-2 text-danger"></i>Quản lý Bán hàng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-2 py-1.5 small" asp-controller="Admin" asp-action="Branding">
                                                <i class="bi bi-palette me-2 text-info"></i>Logo &amp; Thương hiệu
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-2 py-1.5 small" asp-controller="Admin" asp-action="Designer">
                                                <i class="bi bi-brush me-2 text-primary"></i>Web Designer (Giao diện)
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item rounded-2 py-1.5 small text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                Đăng nhập
                            </a>
                            <a class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-none d-xl-inline-block" asp-controller="Account" asp-action="Register">
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Mobile Offcanvas Drawer -->
    <div class="offcanvas offcanvas-end offcanvas-custom" tabindex="-1" id="mobileNavDrawer" aria-labelledby="mobileNavDrawerLabel">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title brand-logo" id="mobileNavDrawerLabel">
                <img src="@logoUrl" alt="@siteName Logo" class="rounded-2" style="height: 30px; width: auto; max-width: 120px; object-fit: contain;" onerror="this.src='/images/logo-default.svg'" />
                @if (showBrandText)
                {
                    <span>@siteName</span>
                }
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column gap-3">
            <!-- Mobile Search -->
            <form asp-controller="Articles" asp-action="Index" method="get">
                <div class="input-group">
                    <input class="form-control" type="search" name="q" placeholder="Tìm bài viết, PLC, IoT..." aria-label="Search">
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>

            <!-- User Box -->
            @if (isAuthenticated)
            {
                <div class="p-3 bg-surface-alt rounded-4 border">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                            @(string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper())
                        </div>
                        <div class="overflow-hidden">
                            <div class="fw-bold text-truncate">@fullName</div>
                            <span class="badge @(isAdmin ? "bg-danger" : isManager ? "bg-success" : "bg-secondary") rounded-pill" style="font-size: 0.7rem;">
                                @role.GetRoleDisplayName()
                            </span>
                        </div>
                    </div>
                    <div class="d-grid gap-1.5">
                        <a asp-controller="Articles" asp-action="MyArticles" class="btn btn-sm btn-outline-primary rounded-3 text-start">
                            <i class="bi bi-file-earmark-text me-1"></i> Bài viết của tôi
                        </a>
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-outline-secondary rounded-3 text-start">
                            <i class="bi bi-person-gear me-1"></i> Hồ sơ tài khoản
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="d-grid gap-2">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary rounded-pill fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary rounded-pill fw-semibold">
                        <i class="bi bi-person-plus me-1"></i> Đăng ký viết bài
                    </a>
                </div>
            }

            <!-- Mobile Links -->
            <div class="list-group list-group-flush">
                <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5">
                    <i class="bi bi-house-door text-primary me-2"></i> Trang chủ
                </a>
                <a asp-controller="Articles" asp-action="Index" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5">
                    <i class="bi bi-journal-code text-primary me-2"></i> Tất cả bài viết
                </a>
                <a asp-controller="Categories" asp-action="Index" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5">
                    <i class="bi bi-grid text-primary me-2"></i> Chuyên mục
                </a>
                <a asp-controller="Snippets" asp-action="Index" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5">
                    <i class="bi bi-code-slash text-primary me-2"></i> Kho Snippets
                </a>
                @if (siteSetting.EnableShopModule || isAdmin)
                {
                    <a asp-controller="Products" asp-action="Index" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5">
                        <i class="bi bi-bag-check text-danger me-2"></i> @(string.IsNullOrWhiteSpace(siteSetting.ShopNavTitle) ? "Sản phẩm" : siteSetting.ShopNavTitle)
                        @if (!siteSetting.EnableShopModule && isAdmin)
                        {
                            <span class="badge bg-warning text-dark ms-1">Chế độ chờ</span>
                        }
                    </a>
                }
                <a asp-controller="Articles" asp-action="Create" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5 fw-semibold text-primary">
                    <i class="bi bi-pencil-square me-2"></i> Viết bài mới
                </a>
                @if (isAdminOrManager)
                {
                    <div class="mt-2 pt-2 border-top small fw-bold text-muted px-2">QUẢN TRỊ & PHÂN QUYỀN</div>
                    <a asp-controller="Admin" asp-action="Index" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5">
                        <i class="bi bi-speedometer2 text-warning me-2"></i> Bảng điều khiển
                    </a>
                    @if (isAdmin)
                    {
                        <a asp-controller="Admin" asp-action="Users" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5">
                            <i class="bi bi-people text-primary me-2"></i> Phân quyền & Tài khoản
                        </a>
                        <a asp-controller="Admin" asp-action="Ads" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5">
                            <i class="bi bi-megaphone text-success me-2"></i> Quản lý Quảng cáo
                        </a>
                        <a asp-controller="Admin" asp-action="Products" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5">
                            <i class="bi bi-shop text-danger me-2"></i> Quản lý Bán hàng
                        </a>
                        <a asp-controller="Admin" asp-action="Branding" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5">
                            <i class="bi bi-palette text-info me-2"></i> Logo &amp; Thương hiệu
                        </a>
                        <a asp-controller="Admin" asp-action="Designer" class="list-group-item list-group-item-action bg-transparent border-0 rounded-3 px-2 py-2.5">
                            <i class="bi bi-brush text-primary me-2"></i> Web Designer (Giao diện)
                        </a>
                    }
                }
            </div>

            @if (isAuthenticated)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-auto">
                    <button type="submit" class="btn btn-outline-danger w-100 rounded-pill">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Header Ad Banner -->
    @await Component.InvokeAsync("AdSlot", new { placement = AdPlacement.HeaderBanner })

    <!-- Global Alert Messages -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <!-- Footer Ad Banner -->
    @await Component.InvokeAsync("AdSlot", new { placement = AdPlacement.FooterBanner })

    <!-- Footer -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <a class="brand-logo mb-3 d-inline-flex text-decoration-none" asp-controller="Home" asp-action="Index">
                        <img src="@logoUrl" alt="@siteName Logo" class="rounded-2" style="height: 32px; width: auto; max-width: 140px; object-fit: contain;" onerror="this.src='/images/logo-default.svg'" />
                        @if (showBrandText)
                        {
                            <span>@siteName</span>
                        }
                    </a>
                    <p id="footer-desc-text" class="small text-muted pe-lg-4">
                        @footerDescription
                    </p>
                    <div class="d-flex gap-2">
                        <a href="@githubUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle" style="width: 34px; height: 34px;"><i class="bi bi-github"></i></a>
                        <a href="@youtubeUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle" style="width: 34px; height: 34px;"><i class="bi bi-youtube text-danger"></i></a>
                        <a href="@linkedinUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle" style="width: 34px; height: 34px;"><i class="bi bi-linkedin text-info"></i></a>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-uppercase fs-7 text-primary">Chuyên mục nổi bật</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a asp-controller="Categories" asp-action="Details" asp-route-slug="industrial-automation" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Tự động hóa công nghiệp</a></li>
                        <li><a asp-controller="Categories" asp-action="Details" asp-route-slug="software-rpa" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Phần mềm & RPA</a></li>
                        <li><a asp-controller="Categories" asp-action="Details" asp-route-slug="iot-embedded" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> IoT & Hệ thống nhúng</a></li>
                        <li><a asp-controller="Categories" asp-action="Details" asp-route-slug="ai-vision" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> AI & Thị giác máy tính</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3 text-uppercase fs-7 text-primary">Liên kết nhanh</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a asp-controller="Articles" asp-action="Index" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Danh sách bài viết</a></li>
                        <li><a asp-controller="Snippets" asp-action="Index" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Kho Code Snippets</a></li>
                        @if (siteSetting.EnableShopModule)
                        {
                            <li><a asp-controller="Products" asp-action="Index" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> @(string.IsNullOrWhiteSpace(siteSetting.ShopNavTitle) ? "Sản phẩm" : siteSetting.ShopNavTitle)</a></li>
                        }
                        <li><a asp-controller="Articles" asp-action="Create" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Đăng bài mới</a></li>
                        <li><a asp-controller="Home" asp-action="About" class="text-muted text-decoration-none hover-primary"><i class="bi bi-chevron-right text-primary small me-1"></i> Giới thiệu website</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-uppercase fs-7 text-primary">Công nghệ xây dựng</h6>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-secondary">ASP.NET Core</span>
                        <span class="badge bg-secondary">C# .NET</span>
                        <span class="badge bg-secondary">EF Core</span>
                        <span class="badge bg-secondary">PostgreSQL</span>
                        <span class="badge bg-secondary">Markdig</span>
                        <span class="badge bg-secondary">Bootstrap 5</span>
                    </div>
                    <p class="small text-muted mt-3 mb-0">
                        &copy; @DateTime.UtcNow.Year @siteName. @siteTagline.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Mobile Bottom Quick Navigation Bar -->
    <nav class="mobile-bottom-nav d-lg-none" aria-label="Điều hướng nhanh di động">
        <a asp-controller="Home" asp-action="Index" class="mobile-bottom-nav-item @(currentController == "Home" ? "active" : "")">
            <i class="bi bi-house-door-fill"></i>
            <span>Trang chủ</span>
        </a>
        <a asp-controller="Articles" asp-action="Index" class="mobile-bottom-nav-item @(currentController == "Articles" && currentAction == "Index" ? "active" : "")">
            <i class="bi bi-journal-code"></i>
            <span>Bài viết</span>
        </a>
        @if (siteSetting.EnableShopModule)
        {
            <a asp-controller="Products" asp-action="Index" class="mobile-bottom-nav-item @(currentController == "Products" ? "active" : "")">
                <i class="bi bi-bag-check-fill"></i>
                <span>@(string.IsNullOrWhiteSpace(siteSetting.ShopNavTitle) ? "Sản phẩm" : siteSetting.ShopNavTitle)</span>
            </a>
        }
        else
        {
            <a asp-controller="Snippets" asp-action="Index" class="mobile-bottom-nav-item @(currentController == "Snippets" ? "active" : "")">
                <i class="bi bi-code-slash"></i>
                <span>Snippets</span>
            </a>
        }
        <a asp-controller="Articles" asp-action="Create" class="mobile-bottom-nav-item @(currentController == "Articles" && currentAction == "Create" ? "active" : "")">
            <i class="bi bi-plus-circle-fill text-primary"></i>
            <span>Viết bài</span>
        </a>
        @if (isAdminOrManager)
        {
            <a asp-controller="Admin" asp-action="Index" class="mobile-bottom-nav-item @(currentController == "Admin" ? "active" : "")">
                <i class="bi bi-speedometer2"></i>
                <span>Quản lý</span>
            </a>
        }
        else if (isAuthenticated)
        {
            <a asp-controller="Articles" asp-action="MyArticles" class="mobile-bottom-nav-item @(currentController == "Articles" && currentAction == "MyArticles" ? "active" : "")">
                <i class="bi bi-person-lines-fill"></i>
                <span>Của tôi</span>
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="mobile-bottom-nav-item @(currentController == "Account" ? "active" : "")">
                <i class="bi bi-person-circle"></i>
                <span>Tài khoản</span>
            </a>
        }
    </nav>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Prism.js for Syntax Highlighting -->
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-csharp.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-python.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-cpp.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-bash.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-json.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-yaml.min.js"></script>

    <!-- Marked.js for Client Live Preview -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <!-- Custom App JS -->
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
